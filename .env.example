# ==============================================================================
# TRUSTEDU ERP: ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================

# Node Environment ('development' | 'production' | 'test')
NODE_ENV=development
PORT=5000
API_BASE_URL=http://localhost:5000

# 1. DATABASE CONFIGURATION (PostgreSQL 14+ / 16)
DATABASE_URL=postgresql://trustedu:trustedu_secret_2026@localhost:5432/trustedu_erp?schema=public
POSTGRES_USER=trustedu
POSTGRES_PASSWORD=trustedu_secret_2026
POSTGRES_DB=trustedu_erp

# 2. CACHE & MESSAGE BROKER (Redis 7)
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379

# 3. ASYNC BACKGROUND WORKER (BullMQ)
CONCURRENCY_OMR_WORKER=4
CONCURRENCY_PAYROLL_WORKER=2
CONCURRENCY_PDF_WORKER=5

# 4. S3-COMPATIBLE OBJECT STORAGE (MinIO / AWS S3)
S3_ENDPOINT=http://localhost:9000
S3_PORT=9000
S3_USE_SSL=false
S3_ACCESS_KEY=trustedu_minio_admin
S3_SECRET_KEY=trustedu_minio_secret_2026
S3_BUCKET=trustedu-vault
S3_REGION=us-east-1

# 5. SECURITY & AUTHENTICATION
JWT_SECRET=trustedu_super_jwt_secret_key_2026_change_in_production
JWT_EXPIRY_HOURS=24
REFRESH_TOKEN_EXPIRY_DAYS=30
COOKIE_SECURE=false

# 6. WHATSAPP BUSINESS CLOUD API
WHATSAPP_PHONE_NUMBER_ID=109283746592019
WHATSAPP_BUSINESS_ACCOUNT_ID=772819283746510
WHATSAPP_API_TOKEN=EAABwzLix...your_meta_token_here
WHATSAPP_WEBHOOK_VERIFY_TOKEN=trustedu_wa_webhook_verify_token

# 7. PAYMENT GATEWAY (Razorpay / Stripe)
RAZORPAY_KEY_ID=rzp_test_sampleKey123
RAZORPAY_KEY_SECRET=rzp_secret_sampleSecret456

# 8. HARDWARE BIOMETRIC EDGE AGENT
BIOMETRIC_EDGE_PORT=4370
BIOMETRIC_EDGE_PROTOCOL=MQTT
BIOMETRIC_STREAM_BUFFER_MAX=1000
