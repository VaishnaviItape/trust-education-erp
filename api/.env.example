# ==============================================================================
# Shree Saraswati Education Trust ERP - API Backend Environment Template
# Duplicate this file to .env.development or .env.production and customize.
# ==============================================================================
NODE_ENV=development
PORT=5000

# Service URLs
API_BASE_URL=http://localhost:5000
FRONTEND_PORTAL_URL=http://localhost:3000
PUBLIC_WEBSITE_URL=https://abceducationtrust.org
SWAGGER_DOCS_URL=http://localhost:5000/api-docs

# Database Connection URL
DATABASE_URL=postgresql://user:password@localhost:5432/trust_education_erp

# JWT Authentication
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=24h

# UPI / Razorpay Payment Gateway
UPI_GATEWAY_KEY_ID=your_payment_key_id
UPI_GATEWAY_KEY_SECRET=your_payment_key_secret

# Alerts & Telemetry
SMS_GATEWAY_API_KEY=your_sms_gateway_key
BUS_GPS_STREAM_SECRET=your_bus_gps_stream_token
