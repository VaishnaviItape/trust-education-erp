# ==============================================================================
# Shree Saraswati Education Trust ERP - Web Portal Environment Template
# Duplicate this file to .env.development or .env.production and customize.
# ==============================================================================
VITE_APP_ENV=development
VITE_APP_NAME="Shree Saraswati Education Trust ERP"
VITE_APP_PORT=3000

# Backend API Endpoint
VITE_API_BASE_URL=http://localhost:5000

# Web Application URLs
VITE_ERP_PORTAL_URL=https://erp.abceducationtrust.org
VITE_PUBLIC_WEBSITE_URL=https://abceducationtrust.org
VITE_SWAGGER_DOCS_URL=http://localhost:5000/api-docs

# Client-Side Integration Keys
VITE_PAYMENT_GATEWAY_KEY=your_client_payment_gateway_key
VITE_MAPS_API_KEY=your_google_maps_api_key
